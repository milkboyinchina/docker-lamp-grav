# ==============================================================================
# Environment Configuration Template (copy to .env and set your values)
# Conventions used on every variable below:
#   PURPOSE ......... what this setting controls.
#   USED WHEN ....... the profiles/modes/files that must be active for it to
#                     have any effect. Anything else = dead config (check-env warns).
#   CHANGE REQUIRES . rebuild | recreate | restart | reload(next up) — what it
#                     takes for a new value to apply. rebuild = make rebuild,
#                     recreate = containers recreated (make up), restart = make
#                     restart, reload = picked up on next make up/start.
# ==============================================================================

# ==============================================================================
# Setup Matrix — pick ONE line for COMPOSE_FILE and ONE for COMPOSE_PROFILES
# ------------------------------------------------------------------------------
# Local development (direct ports):       COMPOSE_FILE=...:docker-compose.direct.yml + COMPOSE_PROFILES= (web only) or db,adminer
# NPM reverse proxy (no host ports):       COMPOSE_FILE=docker-compose.yml + COMPOSE_PROFILES=proxy
# Cloudflare edge (no host ports):         COMPOSE_FILE=docker-compose.yml + COMPOSE_PROFILES=proxy,tunnel + token below
# WARNING: proxied COMPOSE_FILE without the proxy profile serves nothing.
# ==============================================================================

# ==========================================
# PHP Runtime Selection
# ==========================================
# PURPOSE: PHP major.minor for the webserver image (full tag is derived, never hardcoded).
# USED WHEN: always (build arg). Allowed: 8.3 | 8.4 | 8.5.
# Floors: Grav 2.x >= 8.3.11 | Laravel 11/12 >= 8.2 | CodeIgniter 4 >= 8.1 | WordPress 6 >= 7.4.
# CHANGE REQUIRES: rebuild (make rebuild).
PHP_VERSION=8.4

# ==========================================
# Application Type & Document Root
# ==========================================
# PURPOSE: APP_TYPE drives entrypoint behavior (writable dirs, scheduler cron).
# USED WHEN: always. Allowed: grav | laravel | codeigniter | wordpress | custom.
# CHANGE REQUIRES: recreate (make up recreates the webserver container).
APP_TYPE=grav
# PURPOSE: Apache document root inside the container.
# USED WHEN: always; entrypoint rewrites the vhost only when this differs from /var/www/html.
# MUST MATCH: APP_TYPE=laravel requires a value ending in /public.
# CHANGE REQUIRES: recreate (make up).
APACHE_DOCROOT=/var/www/html

# ==========================================
# Compose File Selection (direct vs proxied ports)
# ==========================================
# PURPOSE: which compose files load; controls ALL host port publishing at once.
# USED WHEN: every docker compose invocation (read natively from .env).
# CHANGE REQUIRES: recreate (make up).
#   Direct (default): COMPOSE_FILE=docker-compose.yml:docker-compose.direct.yml
#   Proxied (NPM/Traefik/tunnel): COMPOSE_FILE=docker-compose.yml
COMPOSE_FILE=docker-compose.yml:docker-compose.direct.yml

# ==========================================
# Compose Profiles Configuration
# ==========================================
# PURPOSE: optional services to start (comma-separated).
# USED WHEN: every docker compose invocation.
# CHANGE REQUIRES: reload (next make up).
#   db,adminer,proxy (full local) | db,adminer (app + database) | db (database only)
#   proxy (NPM only) | proxy,tunnel (edge) | empty (webserver only)
COMPOSE_PROFILES=db,adminer

# ==========================================
# Restart Policy Configuration
# ==========================================
# PURPOSE: container restart policy for all stack services.
# USED WHEN: always. Allowed: unless-stopped | always | on-failure | no.
# CHANGE REQUIRES: recreate (make up).
RESTART_POLICY=unless-stopped

# ==========================================
# Database Image Version
# ==========================================
# PURPOSE: MariaDB image tag for the db service.
# USED WHEN: COMPOSE_PROFILES includes db.
# CHANGE REQUIRES: rebuild + volume-compatible upgrade path (back up first: make backup).
MARIADB_VERSION=latest

# ==========================================
# Server & Domain Configuration
# ==========================================
# PURPOSE: SERVER_NAME feeds the Apache ServerName and Traefik router rules;
# SERVER_ADMIN feeds the Apache ServerAdmin.
# USED WHEN: always (webserver); Traefik rules only matter behind Traefik.
# NOTE: use the apex domain here (example.com), not www — Traefik www-redirect rules prepend www automatically.
# CHANGE REQUIRES: recreate (make up).
SERVER_NAME=www.example.com
SERVER_ADMIN=webmaster@example.com

# ==========================================
# Port Mappings (direct mode only)
# ==========================================
# PURPOSE: host ports published by docker-compose.direct.yml.
# USED WHEN: docker-compose.direct.yml is in COMPOSE_FILE. Ignored in proxied mode.
# CHANGE REQUIRES: recreate (make up).
HTTP_PORT=80
# PURPOSE: Adminer UI host port.
# USED WHEN: direct overlay loaded AND COMPOSE_PROFILES includes adminer.
# CHANGE REQUIRES: recreate (make up).
ADMINER_PORT=8080

# PURPOSE: NPM front-door (HTTP), admin UI, and TLS ports.
# USED WHEN: direct overlay loaded AND COMPOSE_PROFILES includes proxy.
# NPM_ADMIN_BIND controls Admin UI exposure: 127.0.0.1 = host-only, 0.0.0.0 = LAN.
# To unpublish the Admin UI entirely, comment out its line in docker-compose.direct.yml.
# CHANGE REQUIRES: recreate (make up).
NPM_HTTP_PORT=8000
NPM_ADMIN_PORT=81
NPM_ADMIN_BIND=127.0.0.1
NPM_HTTPS_PORT=8443

# ==========================================
# Host Volume Paths
# ==========================================
# PURPOSE: SRC_PATH is the web root mounted to /var/www/html. May live outside
# this repo (e.g. /home/user/web-app/site) or use the ./src stub in-repo.
# USED WHEN: always. CHANGE REQUIRES: recreate (make up).
SRC_PATH=./src

# PURPOSE: NPM persistent data and certificates.
# USED WHEN: COMPOSE_PROFILES includes proxy. CHANGE REQUIRES: recreate (make up).
NPM_DATA_PATH=./data/npm
NPM_LETSENCRYPT_PATH=./etc/letsencrypt

# PURPOSE: host log directories (empty = Docker-managed location, logs still work).
# USED WHEN: always. CHANGE REQUIRES: recreate (make up).
LOGS_APACHE_PATH=./logs/apache
LOGS_PHP_PATH=./logs/php

# PURPOSE: single-file config overrides mounted into containers.
# USED WHEN: always (webserver), db profile for the mysql one.
# CHANGE REQUIRES: restart for apache/php (make restart), recreate for db.
CONFIG_APACHE_PATH=./config/apache/000-default.conf
CONFIG_PHP_PATH=./config/php/custom.ini
CONFIG_MYSQL_PATH=./config/mysql/custom.cnf

# PURPOSE: MariaDB data persistence (named volume or host path).
# USED WHEN: COMPOSE_PROFILES includes db. WARNING: changing this orphans the old data.
# CHANGE REQUIRES: recreate (make up). Back up first: make backup.
DB_VOLUME_NAME=dbdata

# ==========================================
# MariaDB Database Credentials
# ==========================================
# PURPOSE: initial database, users, and passwords (first init only — changing
# these later does NOT alter an existing data volume).
# USED WHEN: COMPOSE_PROFILES includes db, on first volume creation.
# CHANGE REQUIRES: fresh volume (stop, remove volume, make up). Secrets: never commit.
MARIADB_DATABASE=grav_db
MARIADB_ROOT_PASSWORD=change_this_root_password
MARIADB_USER=grav_user
MARIADB_PASSWORD=change_this_user_password

# ==========================================
# Backup Configuration
# ==========================================
# PURPOSE: where make backup writes archives and logs.
# USED WHEN: running ./backup.sh. CHANGE REQUIRES: none (read per run).
BACKUP_DIR=./backups
BACKUP_PREFIX=grav_lamp
LOGS_BACKUP_PATH=./logs/backup.log

# ==========================================
# Cloudflare Tunnel
# ==========================================
# PURPOSE: token authenticating the tunnel connector (Zero Trust dashboard).
# USED WHEN: COMPOSE_PROFILES includes tunnel. Empty token = connector exits (see make logs-tunnel).
# CHANGE REQUIRES: recreate (make up). Secret: never commit.
CLOUDFLARE_TUNNEL_TOKEN=
# PURPOSE: origin the tunnel dials inside the Docker network. Change the port
# here if the origin service listens on a different internal port.
# USED WHEN: COMPOSE_PROFILES includes tunnel. CHANGE REQUIRES: recreate (make up).
TUNNEL_ORIGIN_URL=http://proxy-manager:80
