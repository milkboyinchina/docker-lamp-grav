# ==========================================
# Webserver Base Image & PHP Version Selection
# ==========================================
# Select your desired PHP runtime version for the webserver container.
# Available official PHP Debian-Apache options:
#   PHP_IMAGE=php:8.3-apache           (Default - Recommended for Grav CMS 1.7+ & WordPress 6.x+)
#   PHP_IMAGE=php:8.2-apache           (PHP 8.2 LTS)
#   PHP_IMAGE=php:8.1-apache           (PHP 8.1 LTS)
#   PHP_IMAGE=php:8.0-apache           (PHP 8.0)
#   PHP_IMAGE=php:7.4-apache           (Legacy PHP 7.4 - for older WordPress or Grav 1.6 sites)
#   PHP_IMAGE=php:8.3-apache-bookworm  (PHP 8.3 on Debian 12 Bookworm)
PHP_IMAGE=php:8.3-apache

# ==========================================
# Compose File Selection (direct vs proxied ports)
# ==========================================
# Host port publishing is controlled by which compose files are loaded:
#   COMPOSE_FILE=docker-compose.yml:docker-compose.direct.yml (direct standalone access, default)
#   COMPOSE_FILE=docker-compose.yml                             (proxied: NPM / Traefik / tunnel fronts everything)
COMPOSE_FILE=docker-compose.yml:docker-compose.direct.yml

# ==========================================
# Compose Profiles Configuration
# ==========================================
# Enable optional services by profile name (comma-separated).
# Examples:
#   COMPOSE_PROFILES=db,adminer,proxy (Enable MariaDB, Adminer, and Nginx Proxy Manager)
#   COMPOSE_PROFILES=db,adminer       (Enable both MariaDB and Adminer)
#   COMPOSE_PROFILES=db               (Enable MariaDB only)
#   COMPOSE_PROFILES=proxy            (Enable Nginx Proxy Manager only)
#   COMPOSE_PROFILES=                 (Lightweight mode: Apache webserver only)
COMPOSE_PROFILES=db,adminer


# ==========================================
# Restart Policy Configuration
# ==========================================
# Container restart policy for all stack services.
# Options: unless-stopped, always, on-failure, no
RESTART_POLICY=unless-stopped

# ==========================================
# Database Image Version
# ==========================================
MARIADB_VERSION=latest

# ==========================================
# Server & Domain Configuration
# ==========================================
SERVER_NAME=www.example.com
SERVER_ADMIN=webmaster@example.com

# ==========================================
# Port Mappings
# ==========================================
HTTP_PORT=80
ADMINER_PORT=8080

# Nginx Proxy Manager Ports (enabled via COMPOSE_PROFILES=proxy)
NPM_HTTP_PORT=8000
NPM_ADMIN_PORT=81
# Admin UI bind address: 127.0.0.1 = host-only, 0.0.0.0 = LAN-reachable.
# Comment out the admin ports line in docker-compose.direct.yml to unpublish entirely.
NPM_ADMIN_BIND=127.0.0.1
NPM_HTTPS_PORT=8443

# ==========================================
# Host Volume Paths
# ==========================================
# Application web root directory mounted to container /var/www/html
SRC_PATH=./src

# Nginx Proxy Manager data & Let's Encrypt SSL certificates output paths
NPM_DATA_PATH=./data/npm
NPM_LETSENCRYPT_PATH=./etc/letsencrypt

# Apache webserver access and error logs folder mounted to container /var/log/apache2
LOGS_APACHE_PATH=./logs/apache

# PHP runtime error logs folder mounted to container /var/log/php
LOGS_PHP_PATH=./logs/php

# Apache VirtualHost configuration file mounted to container /etc/apache2/sites-available/000-default.conf
CONFIG_APACHE_PATH=./config/apache/000-default.conf

# Custom php.ini configuration overrides file mounted to container /usr/local/etc/php/conf.d/custom.ini
CONFIG_PHP_PATH=./config/php/custom.ini

# Custom MariaDB server configuration file mounted to container /etc/mysql/conf.d/custom.cnf
CONFIG_MYSQL_PATH=./config/mysql/custom.cnf

# MariaDB persistent database volume name or host directory path mounted to container /var/lib/mysql
DB_VOLUME_NAME=dbdata

# ==========================================
# MariaDB Database Credentials
# ==========================================
MARIADB_DATABASE=grav_db
MARIADB_ROOT_PASSWORD=change_this_root_password
MARIADB_USER=grav_user
MARIADB_PASSWORD=change_this_user_password

# ==========================================
# Backup Configuration
# ==========================================
# Host directory output path for generated backup archives
BACKUP_DIR=./backups

# Custom filename prefix for backup files (e.g. grav_lamp_www_20260722_120000.tar.gz)
BACKUP_PREFIX=grav_lamp

# Path to append backup operation execution logs and warnings
LOGS_BACKUP_PATH=./logs/backup.log

# ==========================================
# Deployment Configuration
# ==========================================
# Deployment transport mode: rsync or ftp
DEPLOY_MODE=rsync

# Target stack base directory for local/rsync deploys (deploy.sh).
# Scoped destinations are derived from this base (<base>/src, <base>/src/user,
# <base>/src/user/pages). Set this to your target stack location; scripts have
# no hardcoded fallback so renaming directories can never recreate stale paths.
# Example: DEPLOY_TARGET_BASE=/mnt/1.milkboy/docker/docker-lamp-grav
DEPLOY_TARGET_BASE=

# Source directory for the Windows helper scripts (scripts\*.bat) only.
# Bash scripts (deploy.sh, upload-article.sh) resolve the web root from SRC_PATH.
DEPLOY_SRC_DIR=./src/user

# Target deployment destination path (for local/rsync mode)
DEPLOY_DEST_DIR=/mnt/1.milkboy/docker/docker-lamp-grav/src/user

# Directory for storing deployment run logs
DEPLOY_LOG_DIR=./logs/deployments

# FTP Deployment Settings (used when DEPLOY_MODE=ftp or --ftp flag is passed)
FTP_HOST=ftp.example.com
FTP_PORT=21
FTP_USER=ftp_username
FTP_PASS=ftp_password
FTP_REMOTE_DIR=/public_html/user
FTP_SSL=false

# ==========================================
# Cloudflare Tunnel (enabled via COMPOSE_PROFILES=tunnel, typically with proxy)
# ==========================================
# Tunnel token from Cloudflare Zero Trust dashboard (secret - never commit).
# The tunnel container exits if this is empty; check logs with make logs-tunnel.
CLOUDFLARE_TUNNEL_TOKEN=
# Origin the tunnel dials inside grav-network (--url works with token runs
# when the dashboard defines no ingress rules). Change the port here if NPM
# listens on a different internal port.
TUNNEL_ORIGIN_URL=http://proxy-manager:80